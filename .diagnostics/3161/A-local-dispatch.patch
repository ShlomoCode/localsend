--- /dev/null
+++ b/tests/at-spi2-atk/socket-local-experiment.c
@@ -0,0 +1,489 @@
+/* Experimental regression tests, to be built/run only in the cloud guest.
+ * Include the production implementation so static forwarding vfuncs and
+ * Embedded binding are exercised directly, with the real SpiRegister. */
+#include <sys/types.h>
+#include <sys/wait.h>
+#include <unistd.h>
+#include <stdlib.h>
+
+#define spi_initialize_socket test_spi_initialize_socket
+#include "../../atk-adaptor/adaptors/socket-adaptor.c"
+#undef spi_initialize_socket
+
+typedef struct _Fixture Fixture;
+typedef struct
+{
+  AtkSocket parent;
+  Fixture *fixture;
+  gint origin_x, origin_y;
+  guint extents_calls, position_calls, size_calls;
+  gboolean recurse, remove_owner;
+} ProbeSocket;
+typedef struct { AtkSocketClass parent; } ProbeSocketClass;
+
+struct _Fixture
+{
+  AtkObject *plug;
+  AtkObject *socket;
+  gchar *socket_path;
+  gboolean finalized;
+};
+
+static void probe_component_init (AtkComponentIface *iface);
+G_DEFINE_TYPE_WITH_CODE (ProbeSocket, probe_socket, ATK_TYPE_SOCKET,
+                         G_IMPLEMENT_INTERFACE (ATK_TYPE_COMPONENT, probe_component_init))
+
+static void
+probe_extents (AtkComponent *component, gint *x, gint *y, gint *w, gint *h, AtkCoordType coord)
+{
+  ProbeSocket *probe = (ProbeSocket *) component;
+  probe->extents_calls++;
+  if (probe->recurse)
+    {
+      gint nested_w = 0, nested_h = 0;
+      atk_component_get_size (ATK_COMPONENT (probe->fixture->plug), &nested_w, &nested_h);
+      g_assert_cmpint (nested_w, ==, -1);
+      g_assert_cmpint (nested_h, ==, -1);
+    }
+  if (probe->remove_owner)
+    g_clear_object (&probe->fixture->socket);
+  /* Access after dropping the external owner detects missing temporary refs. */
+  *x = probe->origin_x + (coord == ATK_XY_SCREEN ? 300 : 0);
+  *y = probe->origin_y + (coord == ATK_XY_SCREEN ? 200 : 0);
+  *w = 81;
+  *h = 47;
+}
+
+static void
+probe_position (AtkComponent *component, gint *x, gint *y, AtkCoordType coord)
+{
+  ProbeSocket *probe = (ProbeSocket *) component;
+  probe->position_calls++;
+  *x = 19 + (coord == ATK_XY_SCREEN ? 300 : 0);
+  *y = 23 + (coord == ATK_XY_SCREEN ? 200 : 0);
+}
+
+static void
+probe_size (AtkComponent *component, gint *w, gint *h)
+{
+  ((ProbeSocket *) component)->size_calls++;
+  *w = 93;
+  *h = 59;
+}
+
+static void
+probe_component_init (AtkComponentIface *iface)
+{
+  iface->get_extents = probe_extents;
+  iface->get_position = probe_position;
+  iface->get_size = probe_size;
+}
+static void probe_socket_class_init (ProbeSocketClass *klass) { (void) klass; }
+static void
+probe_socket_init (ProbeSocket *probe)
+{
+  probe->origin_x = 11;
+  probe->origin_y = 17;
+}
+
+static void
+socket_finalized (gpointer data, GObject *object)
+{
+  (void) object;
+  ((Fixture *) data)->finalized = TRUE;
+}
+
+/* Use the real Embedded handler and its per-object data lifecycle. Sending the
+ * message itself through DRoute is a separate desktop integration control. */
+static void
+embed_message (Fixture *f, const gchar *sender, const gchar *path)
+{
+  DBusMessage *message = dbus_message_new_method_call (sender,
+      "/org/a11y/atspi/accessible/1", ATSPI_DBUS_INTERFACE_SOCKET, "Embedded");
+  DBusMessage *reply;
+  g_assert_nonnull (message);
+  dbus_message_set_serial (message, 1);
+  g_assert_true (dbus_message_set_sender (message, sender));
+  g_assert_true (dbus_message_append_args (message, DBUS_TYPE_STRING, &path, DBUS_TYPE_INVALID));
+  reply = impl_Embedded (spi_global_app_data->bus, message, f->plug);
+  g_assert_nonnull (reply);
+  g_assert_cmpint (dbus_message_get_type (reply), ==, DBUS_MESSAGE_TYPE_METHOD_RETURN);
+  dbus_message_unref (reply);
+  dbus_message_unref (message);
+}
+
+static void
+setup (Fixture *f, gconstpointer type)
+{
+  DBusError error;
+  gchar *plug_path, *plug_id;
+  const gchar *unique;
+  g_assert_null (spi_global_register);
+  g_assert_null (spi_global_app_data);
+  spi_global_app_data = g_new0 (SpiBridge, 1);
+  dbus_error_init (&error);
+  spi_global_app_data->bus = dbus_bus_get_private (DBUS_BUS_SESSION, &error);
+  g_assert_false (dbus_error_is_set (&error));
+  g_assert_nonnull (spi_global_app_data->bus);
+  dbus_connection_set_exit_on_disconnect (spi_global_app_data->bus, FALSE);
+  spi_global_register = g_object_new (SPI_REGISTER_TYPE, NULL);
+  socket_owner_thread = g_thread_self ();
+  f->plug = atk_plug_new ();
+  f->socket = type ? g_object_new (probe_socket_get_type (), NULL) : atk_socket_new ();
+  if (type)
+    ((ProbeSocket *) f->socket)->fixture = f;
+  unique = dbus_bus_get_unique_name (spi_global_app_data->bus);
+  plug_path = spi_register_object_to_path (spi_global_register, G_OBJECT (f->plug));
+  f->socket_path = spi_register_object_to_path (spi_global_register, G_OBJECT (f->socket));
+  plug_id = g_strdup_printf ("%s:%s", unique, plug_path);
+  /* No bridge embed hooks are installed in this fixture. Set the same public
+   * AtkSocket field that atk_socket_embed sets before its embed hook. */
+  ATK_SOCKET (f->socket)->embedded_plug_id = plug_id;
+  g_object_weak_ref (G_OBJECT (f->socket), socket_finalized, f);
+  embed_message (f, unique, f->socket_path);
+  g_free (plug_path);
+}
+
+static void
+teardown (Fixture *f, gconstpointer unused)
+{
+  (void) unused;
+  g_clear_object (&f->socket);
+  g_clear_object (&f->plug);
+  g_free (f->socket_path);
+  g_clear_object (&spi_global_register);
+  dbus_connection_close (spi_global_app_data->bus);
+  dbus_connection_unref (spi_global_app_data->bus);
+  g_free (spi_global_app_data);
+  spi_global_app_data = NULL;
+}
+
+static void
+assert_failed (Fixture *f)
+{
+  gint x = 0, y = 0, w = 0, h = 0;
+  atk_component_get_extents (ATK_COMPONENT (f->plug), &x, &y, &w, &h, ATK_XY_SCREEN);
+  g_assert_cmpint (x, ==, -1); g_assert_cmpint (y, ==, -1);
+  g_assert_cmpint (w, ==, -1); g_assert_cmpint (h, ==, -1);
+}
+
+static void
+valid_methods (Fixture *f, gconstpointer unused)
+{
+  gint x, y, w, h;
+  ProbeSocket *probe = (ProbeSocket *) f->socket;
+  (void) unused;
+  atk_component_get_extents (ATK_COMPONENT (f->plug), &x, &y, &w, &h, ATK_XY_SCREEN);
+  g_assert_cmpint (x, ==, 311); g_assert_cmpint (y, ==, 217);
+  g_assert_cmpint (w, ==, 81); g_assert_cmpint (h, ==, 47);
+  probe->origin_x += 40;
+  probe->origin_y += 60;
+  atk_component_get_extents (ATK_COMPONENT (f->plug), &x, &y, &w, &h, ATK_XY_WINDOW);
+  g_assert_cmpint (x, ==, 51); g_assert_cmpint (y, ==, 77);
+  atk_component_get_position (ATK_COMPONENT (f->plug), &x, &y, ATK_XY_WINDOW);
+  g_assert_cmpint (x, ==, 19); g_assert_cmpint (y, ==, 23);
+  atk_component_get_size (ATK_COMPONENT (f->plug), &w, &h);
+  g_assert_cmpint (w, ==, 93); g_assert_cmpint (h, ==, 59);
+  g_assert_cmpuint (probe->extents_calls, ==, 2);
+  g_assert_cmpuint (probe->position_calls, ==, 1);
+  g_assert_cmpuint (probe->size_calls, ==, 1);
+}
+
+static void
+assert_native_contract (Fixture *f, const gchar *phase, AtkCoordType coord,
+                        gint expected_x, gint expected_y, gint expected_w, gint expected_h)
+{
+  gint x, y, w, h, native_x, native_y, native_w, native_h;
+  atk_component_get_extents (ATK_COMPONENT (f->socket), &native_x, &native_y, &native_w, &native_h, coord);
+  g_test_message ("native socket phase=%s method=extents coord=%d x=%d y=%d w=%d h=%d",
+                  phase, coord, native_x, native_y, native_w, native_h);
+  g_assert_cmpint (native_x, ==, expected_x); g_assert_cmpint (native_y, ==, expected_y);
+  g_assert_cmpint (native_w, ==, expected_w); g_assert_cmpint (native_h, ==, expected_h);
+  atk_component_get_extents (ATK_COMPONENT (f->plug), &x, &y, &w, &h, coord);
+  g_assert_cmpint (x, ==, native_x); g_assert_cmpint (y, ==, native_y);
+  g_assert_cmpint (w, ==, native_w); g_assert_cmpint (h, ==, native_h);
+
+  /* ATK's default position/size methods call the socket's extents method,
+   * not the parent's distinct position/size methods. Use the public native
+   * socket as the method-specific oracle, with fixed geometry expectations. */
+  atk_component_get_position (ATK_COMPONENT (f->socket), &native_x, &native_y, coord);
+  g_test_message ("native socket phase=%s method=position coord=%d x=%d y=%d", phase, coord, native_x, native_y);
+  g_assert_cmpint (native_x, ==, expected_x); g_assert_cmpint (native_y, ==, expected_y);
+  atk_component_get_position (ATK_COMPONENT (f->plug), &x, &y, coord);
+  g_assert_cmpint (x, ==, native_x); g_assert_cmpint (y, ==, native_y);
+
+  atk_component_get_size (ATK_COMPONENT (f->socket), &native_w, &native_h);
+  g_test_message ("native socket phase=%s method=size w=%d h=%d", phase, native_w, native_h);
+  g_assert_cmpint (native_w, ==, expected_w); g_assert_cmpint (native_h, ==, expected_h);
+  atk_component_get_size (ATK_COMPONENT (f->plug), &w, &h);
+  g_assert_cmpint (w, ==, native_w); g_assert_cmpint (h, ==, native_h);
+}
+
+static void
+base_contract (Fixture *f, gconstpointer unused)
+{
+  AtkObject *host = g_object_new (probe_socket_get_type (), NULL);
+  (void) unused;
+  assert_native_contract (f, "no-parent", ATK_XY_SCREEN, -1, -1, -1, -1);
+  assert_native_contract (f, "no-parent", ATK_XY_WINDOW, -1, -1, -1, -1);
+  atk_object_set_parent (f->socket, host);
+  assert_native_contract (f, "parent", ATK_XY_SCREEN, 311, 217, 81, 47);
+  assert_native_contract (f, "parent", ATK_XY_WINDOW, 11, 17, 81, 47);
+  ((ProbeSocket *) host)->origin_x += 40;
+  ((ProbeSocket *) host)->origin_y += 60;
+  assert_native_contract (f, "changed-parent", ATK_XY_SCREEN, 351, 277, 81, 47);
+  assert_native_contract (f, "changed-parent", ATK_XY_WINDOW, 51, 77, 81, 47);
+  atk_object_set_parent (f->socket, NULL);
+  assert_native_contract (f, "removed-parent", ATK_XY_SCREEN, -1, -1, -1, -1);
+  assert_native_contract (f, "removed-parent", ATK_XY_WINDOW, -1, -1, -1, -1);
+  g_object_unref (host);
+}
+
+static void
+removed_path (Fixture *f, gconstpointer unused)
+{
+  (void) unused;
+  spi_register_deregister_object (spi_global_register, G_OBJECT (f->socket), TRUE);
+  assert_failed (f);
+  g_assert_false (f->finalized); /* Removal alone must invalidate a live object. */
+}
+
+static void
+disposed_socket (Fixture *f, gconstpointer unused)
+{
+  LocalSocketBinding *binding = g_object_get_data (G_OBJECT (f->plug), "spi-local-socket-binding");
+  (void) unused;
+  g_object_run_dispose (G_OBJECT (f->socket));
+  g_assert_null (g_weak_ref_get (&binding->socket));
+  assert_failed (f);
+}
+
+static void
+stale_path_reused (Fixture *f, gconstpointer unused)
+{
+  guint old_id = spi_register_object_to_ref (G_OBJECT (f->socket));
+  AtkObject *replacement = atk_socket_new ();
+  gchar *replacement_path;
+  (void) unused;
+  spi_register_deregister_object (spi_global_register, G_OBJECT (f->socket), TRUE);
+  /* Force the allocator to reuse this ID: a stale binding must not attach to
+   * an unrelated object merely because its path has become resolvable again. */
+  spi_global_register->reference_counter = old_id - 1;
+  replacement_path = spi_register_object_to_path (spi_global_register, G_OBJECT (replacement));
+  g_assert_cmpstr (replacement_path, ==, f->socket_path);
+  assert_failed (f);
+  g_free (replacement_path);
+  g_object_unref (replacement);
+}
+
+static void
+reembed_after_removal (Fixture *f, gconstpointer unused)
+{
+  AtkObject *replacement = g_object_new (probe_socket_get_type (), NULL);
+  gchar *new_path;
+  (void) unused;
+  ((ProbeSocket *) replacement)->fixture = f;
+  ATK_SOCKET (replacement)->embedded_plug_id = g_strdup (ATK_SOCKET (f->socket)->embedded_plug_id);
+  spi_register_deregister_object (spi_global_register, G_OBJECT (f->socket), TRUE);
+  assert_failed (f);
+  new_path = spi_register_object_to_path (spi_global_register, G_OBJECT (replacement));
+  g_assert_cmpstr (new_path, !=, f->socket_path);
+  g_clear_object (&f->socket);
+  f->socket = replacement;
+  f->finalized = FALSE;
+  g_object_weak_ref (G_OBJECT (replacement), socket_finalized, f);
+  g_free (f->socket_path);
+  f->socket_path = new_path;
+  embed_message (f, dbus_bus_get_unique_name (spi_global_app_data->bus), new_path);
+  valid_methods (f, NULL); /* A failed old binding must not poison the new one. */
+}
+
+static void
+owner_removed_inside_call (Fixture *f, gconstpointer unused)
+{
+  gint x, y, w, h;
+  (void) unused;
+  ((ProbeSocket *) f->socket)->remove_owner = TRUE;
+  atk_component_get_extents (ATK_COMPONENT (f->plug), &x, &y, &w, &h, ATK_XY_SCREEN);
+  g_assert_cmpint (x, ==, 311); g_assert_cmpint (w, ==, 81);
+  g_assert_null (f->socket);
+  g_assert_true (f->finalized); /* Held reference is released after dispatch. */
+  assert_failed (f);
+}
+
+static void
+cross_method_cycle (Fixture *f, gconstpointer unused)
+{
+  gint x, y, w, h;
+  ProbeSocket *probe = (ProbeSocket *) f->socket;
+  (void) unused;
+  probe->recurse = TRUE;
+  atk_component_get_extents (ATK_COMPONENT (f->plug), &x, &y, &w, &h, ATK_XY_SCREEN);
+  g_assert_cmpint (x, ==, 311);
+  g_assert_cmpuint (probe->extents_calls, ==, 1);
+  g_assert_cmpuint (probe->size_calls, ==, 0);
+  /* Verify the guard was popped: the next unrelated method remains usable. */
+  atk_component_get_size (ATK_COMPONENT (f->plug), &w, &h);
+  g_assert_cmpint (w, ==, 93);
+}
+
+static gpointer
+off_thread_call (gpointer data)
+{
+  assert_failed (data);
+  return NULL;
+}
+static void
+wrong_thread (Fixture *f, gconstpointer unused)
+{
+  GThread *thread;
+  SpiBridge *saved_app = spi_global_app_data;
+  (void) unused;
+  /* A guard after global bus access would dereference this poisoned pointer. */
+  spi_global_app_data = (SpiBridge *) GINT_TO_POINTER (1);
+  thread = g_thread_new ("off-owner", off_thread_call, f);
+  g_thread_join (thread);
+  spi_global_app_data = saved_app;
+  g_assert_cmpuint (((ProbeSocket *) f->socket)->extents_calls, ==, 0);
+}
+
+static void
+identity_controls (Fixture *f, gconstpointer unused)
+{
+  const gchar *unique = dbus_bus_get_unique_name (spi_global_app_data->bus);
+  gchar *alias = g_strconcat (f->socket_path, "junk", NULL);
+  AtkObject *wrong = atk_plug_new ();
+  gchar *wrong_path = spi_register_object_to_path (spi_global_register, G_OBJECT (wrong));
+  (void) unused;
+  embed_message (f, unique, alias);
+  assert_failed (f);
+  embed_message (f, unique, wrong_path);
+  assert_failed (f);
+  embed_message (f, unique, f->socket_path);
+  g_free (ATK_SOCKET (f->socket)->embedded_plug_id);
+  ATK_SOCKET (f->socket)->embedded_plug_id = g_strdup ("other-plug");
+  /* The remote component handler does not require reciprocal occupancy.
+   * Preserve that geometry contract instead of silently strengthening it. */
+  valid_methods (f, NULL);
+  g_free (wrong_path); g_free (alias); g_object_unref (wrong);
+}
+
+/* A real second process owns this destination and services all three methods.
+ * Distinct values and signatures detect accidental extents substitution. */
+static void
+remote_child (int notify_fd)
+{
+  DBusError error;
+  DBusConnection *connection;
+  guint received = 0;
+  gint64 deadline = g_get_monotonic_time () + 15 * G_TIME_SPAN_SECOND;
+  dbus_error_init (&error);
+  connection = dbus_bus_get_private (DBUS_BUS_SESSION, &error);
+  if (!connection || dbus_error_is_set (&error)) _exit (20);
+  const gchar *unique = dbus_bus_get_unique_name (connection);
+  if (write (notify_fd, unique, strlen (unique) + 1) != (ssize_t) strlen (unique) + 1) _exit (21);
+  close (notify_fd);
+  while (received < 3 && g_get_monotonic_time () < deadline &&
+         dbus_connection_read_write (connection, 1000))
+    {
+      DBusMessage *message = dbus_connection_pop_message (connection);
+      if (!message) continue;
+      if (dbus_message_get_type (message) == DBUS_MESSAGE_TYPE_METHOD_CALL)
+        {
+          DBusMessage *reply = dbus_message_new_method_return (message);
+          const gchar *member = dbus_message_get_member (message);
+          g_assert_cmpstr (dbus_message_get_path (message), ==, "/org/a11y/atspi/accessible/99");
+          g_assert_cmpstr (dbus_message_get_interface (message), ==, ATSPI_DBUS_INTERFACE_COMPONENT);
+          if (g_str_equal (member, "GetExtents"))
+            {
+              dbus_uint32_t coord;
+              gint32 values[] = { 701, 702, 703, 704 };
+              DBusMessageIter iter, rect;
+              g_assert_true (dbus_message_get_args (message, NULL, DBUS_TYPE_UINT32, &coord, DBUS_TYPE_INVALID));
+              g_assert_cmpuint (coord, ==, ATK_XY_WINDOW);
+              dbus_message_iter_init_append (reply, &iter);
+              dbus_message_iter_open_container (&iter, DBUS_TYPE_STRUCT, NULL, &rect);
+              for (guint i = 0; i < G_N_ELEMENTS (values); i++)
+                dbus_message_iter_append_basic (&rect, DBUS_TYPE_INT32, &values[i]);
+              dbus_message_iter_close_container (&iter, &rect);
+            }
+          else
+            {
+              gint32 a = 801, b = 802;
+              if (g_str_equal (member, "GetPosition"))
+                {
+                  dbus_uint32_t coord;
+                  g_assert_true (dbus_message_get_args (message, NULL, DBUS_TYPE_UINT32, &coord, DBUS_TYPE_INVALID));
+                  g_assert_cmpuint (coord, ==, ATK_XY_SCREEN);
+                }
+              else
+                {
+                  g_assert_cmpstr (member, ==, "GetSize");
+                  g_assert_cmpstr (dbus_message_get_signature (message), ==, "");
+                  a = 901; b = 902;
+                }
+              dbus_message_append_args (reply, DBUS_TYPE_INT32, &a, DBUS_TYPE_INT32, &b, DBUS_TYPE_INVALID);
+            }
+          dbus_connection_send (connection, reply, NULL);
+          dbus_connection_flush (connection);
+          dbus_message_unref (reply);
+          received++;
+        }
+      dbus_message_unref (message);
+    }
+  dbus_connection_close (connection);
+  dbus_connection_unref (connection);
+  _exit (received == 3 ? 0 : 22);
+}
+
+static void
+remote_process (Fixture *f, gconstpointer unused)
+{
+  int pipe_fds[2], status;
+  pid_t child;
+  gchar name[256] = { 0 };
+  gint x, y, w, h;
+  (void) unused;
+  g_assert_cmpint (pipe (pipe_fds), ==, 0);
+  child = fork ();
+  g_assert_cmpint (child, >=, 0);
+  if (child == 0)
+    {
+      close (pipe_fds[0]);
+      remote_child (pipe_fds[1]);
+    }
+  close (pipe_fds[1]);
+  g_assert_cmpint (read (pipe_fds[0], name, sizeof name - 1), >, 0);
+  close (pipe_fds[0]);
+  g_assert_cmpstr (name, !=, dbus_bus_get_unique_name (spi_global_app_data->bus));
+  embed_message (f, name, "/org/a11y/atspi/accessible/99");
+  atk_component_get_extents (ATK_COMPONENT (f->plug), &x, &y, &w, &h, ATK_XY_WINDOW);
+  g_assert_cmpint (x, ==, 701); g_assert_cmpint (y, ==, 702);
+  g_assert_cmpint (w, ==, 703); g_assert_cmpint (h, ==, 704);
+  atk_component_get_position (ATK_COMPONENT (f->plug), &x, &y, ATK_XY_SCREEN);
+  g_assert_cmpint (x, ==, 801); g_assert_cmpint (y, ==, 802);
+  atk_component_get_size (ATK_COMPONENT (f->plug), &w, &h);
+  g_assert_cmpint (w, ==, 901); g_assert_cmpint (h, ==, 902);
+  g_assert_cmpint (waitpid (child, &status, 0), ==, child);
+  g_assert_true (WIFEXITED (status)); g_assert_cmpint (WEXITSTATUS (status), ==, 0);
+  /* Disconnected remote owner must still use the normal D-Bus error path. */
+  assert_failed (f);
+}
