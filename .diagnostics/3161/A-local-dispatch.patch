+int
+main (int argc, char **argv)
+{
+  g_test_init (&argc, &argv, NULL);
+  g_test_add ("/socket-local/valid-methods", Fixture, GINT_TO_POINTER (1), setup, valid_methods, teardown);
+  g_test_add ("/socket-local/base-contract", Fixture, NULL, setup, base_contract, teardown);
+  g_test_add ("/socket-local/removed", Fixture, GINT_TO_POINTER (1), setup, removed_path, teardown);
+  g_test_add ("/socket-local/disposed", Fixture, GINT_TO_POINTER (1), setup, disposed_socket, teardown);
+  g_test_add ("/socket-local/reused-path", Fixture, GINT_TO_POINTER (1), setup, stale_path_reused, teardown);
+  g_test_add ("/socket-local/reembed", Fixture, GINT_TO_POINTER (1), setup, reembed_after_removal, teardown);
+  g_test_add ("/socket-local/owner-removed-in-call", Fixture, GINT_TO_POINTER (1), setup, owner_removed_inside_call, teardown);
+  g_test_add ("/socket-local/cross-method-cycle", Fixture, GINT_TO_POINTER (1), setup, cross_method_cycle, teardown);
+  g_test_add ("/socket-local/wrong-thread", Fixture, GINT_TO_POINTER (1), setup, wrong_thread, teardown);
+  g_test_add ("/socket-local/identity", Fixture, GINT_TO_POINTER (1), setup, identity_controls, teardown);
+  g_test_add ("/socket-local/remote-process", Fixture, GINT_TO_POINTER (1), setup, remote_process, teardown);
+  return g_test_run ();
+}
