+    // Diagnostic only: never log payload values or use these groups as fallbacks.
+    private static func observe3197(_ stage: String) {
+        let bundle = Bundle.main.bundleIdentifier ?? ""
+        let host = bundle.split(separator: ".").dropLast().joined(separator: ".")
+        let derived = "group.\(host)"
+        let configured = Bundle.main.object(forInfoDictionaryKey: "AppGroupId") as? String
+        var groups = ["group.org.localsend.localsendApp", derived]
+        if let configured = configured { groups.append(configured) }
+        for group in Set(groups).sorted() {
+            let available = FileManager.default.containerURL(forSecurityApplicationGroupIdentifier: group) != nil
+            let defaults = UserDefaults(suiteName: group)
+            let value = defaults?.object(forKey: "ShareKey")
+            let length = (value as? Data)?.count ?? (value as? String)?.utf8.count ?? -1
+            let record: [String: Any] = [
+                "role": "extension", "stage": stage, "bundle": bundle,
+                "host": host, "derivedGroup": derived,
+                "configuredGroup": configured ?? "", "queriedGroup": group,
+                "containerAvailable": available,
+                "shareKeyPresent": value != nil, "shareKeyLength": length
+            ]
+            if let data = try? JSONSerialization.data(withJSONObject: record, options: [.sortedKeys]),
+               let line = String(data: data, encoding: .utf8) {
+                NSLog("LS3197_OBSERVE %@", line)
+            }
+        }
+    }
