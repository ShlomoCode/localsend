+
+// Diagnostic portal prototype. The portal has no public enabled-state getter;
+// these preferences record its accepted response, not externally changed state.
+Future<bool> _setFlatpakAutoStart({required bool enabled, bool startHidden = false}) async {
+  final portal = XdgDesktopPortalClient();
+  try {
+    final result = await portal.background.requestBackground(
+      autostart: enabled,
+      commandLine: enabled ? [Platform.resolvedExecutable, if (startHidden) startHiddenFlag] : null,
+      dBusActivatable: false,
+    ).first.timeout(const Duration(minutes: 2));
+    final prefs = await SharedPreferences.getInstance();
+    await prefs.setBool(_flatpakAutoStartKey, result.autostart);
+    await prefs.setBool(_flatpakAutoStartHiddenKey, result.autostart && startHidden);
+    return result.autostart == enabled;
+  } finally {
+    await portal.close();
+  }
+}
 
